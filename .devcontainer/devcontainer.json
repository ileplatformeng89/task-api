{
    "name": "Tasks API Development",
  
    "build": {
      "dockerfile": "Dockerfile"
    },
  
    "workspaceFolder": "/workspaces/tasks-api",
  
    "features": {
      "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
        "moby": false
      }
    },

    "mounts": [
      "source=tasks-api-venv,target=/workspaces/tasks-api/.venv,type=volume",
      "source=${localWorkspaceFolder}/secrets,target=${localWorkspaceFolder}/secrets,type=bind,readonly"
    ],

    "remoteUser": "vscode",
    "containerUser": "vscode",

    "containerEnv": {
      "UV_LINK_MODE": "copy",
      "HOST_PROJECT_PATH": "${localWorkspaceFolder}"
    },
  
    "postCreateCommand": "sudo chown -R vscode:vscode /workspaces/tasks-api/.venv && uv sync --frozen",
  
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "charliermarsh.ruff"
        ]
      }
    }
  }